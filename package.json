{
  "name": "tradesmen-website-engine",
  "version": "1.0.0",
  "type": "module",
  "description": "Ultra-fast, mobile-first, high-converting website platform for Irish & UK tradesmen (Electricians, Plumbers, Contractors)",
  "scripts": {
    "dev": "astro dev",
    "dev:electrician": "TRADE_CONFIG=electrician astro dev",
    "dev:plumber": "TRADE_CONFIG=plumber astro dev",
    "dev:contractor": "TRADE_CONFIG=contractor astro dev",
    "build": "ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:electrician": "TRADE_CONFIG=electrician ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:plumber": "TRADE_CONFIG=plumber ASTRO_TELEMETRY_DISABLED=1 astro build",
    "build:contractor": "TRADE_CONFIG=contractor ASTRO_TELEMETRY_DISABLED=1 astro build",
    "preview": "astro preview"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^12.6.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "astro": "^5.18.2"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
