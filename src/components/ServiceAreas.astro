---
import siteConfig from '../../site.config';
---

<section class="section areas-section" id="areas">
  <div class="container">
    <div class="areas-wrapper">
      <div class="areas-content">
        <span class="badge badge-blue">Local Dublin Coverage</span>
        <h2 class="areas-title">Areas Covered Across {siteConfig.county}</h2>
        <p class="areas-text">
          We operate fully stocked mobile electrical service vans across Dublin city and county, providing emergency response and scheduled domestic & commercial works.
        </p>

        <div class="areas-grid">
          {siteConfig.serviceAreas.map((area) => (
            <div class="area-pill">
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
              <span>{area.name}</span>
              {area.postcode && <span class="area-code">{area.postcode}</span>}
            </div>
          ))}
        </div>

        <div class="area-callout">
          <p>Don't see your area listed? Give us a quick call on <a href={`tel:${siteConfig.phone}`}>{siteConfig.phoneDisplay}</a> — we cover all surrounding areas.</p>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .areas-section {
    background: #FFFFFF;
    border-top: 1px solid var(--color-border);
  }

  .areas-content {
    max-width: 900px;
    margin: 0 auto;
    text-align: center;
  }

  .areas-title {
    font-size: 2rem;
    margin: 0.75rem 0 1rem;
  }

  @media (min-width: 768px) {
    .areas-title {
      font-size: 2.35rem;
    }
  }

  .areas-text {
    color: var(--color-text-muted);
    font-size: 1.05rem;
    margin-bottom: 2.5rem;
  }

  .areas-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: center;
    margin-bottom: 2.5rem;
  }

  .area-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: #F8FAFC;
    border: 1px solid var(--color-border);
    padding: 0.55rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--color-primary);
    transition: all 0.15s ease;
  }

  .area-pill:hover {
    border-color: var(--color-accent);
    background: #FEF3C7;
  }

  .area-pill svg {
    color: #0284C7;
  }

  .area-code {
    font-size: 0.75rem;
    color: var(--color-text-muted);
    font-weight: 400;
  }

  .area-callout {
    font-size: 0.9375rem;
    color: var(--color-text-muted);
    padding: 1.25rem;
    background: #F1F5F9;
    border-radius: 8px;
    display: inline-block;
  }

  .area-callout a {
    color: var(--color-primary);
    font-weight: 700;
    text-decoration: underline;
  }
</style>
