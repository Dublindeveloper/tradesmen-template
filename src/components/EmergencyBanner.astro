---
import siteConfig from '../../site.config';
---

<div class="emergency-bar">
  <div class="container emergency-content">
    <div class="emergency-left">
      <span class="pulsing-dot"></span>
      <strong>24/7 Rapid Emergency Response:</strong>
      <span class="emergency-note">Electrical faults, power outage & burning smells across {siteConfig.county}. {siteConfig.emergencyResponseTime}.</span>
    </div>
    <div class="emergency-right">
      <a href={`tel:${siteConfig.phone}`} class="emergency-call-btn">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
        Call {siteConfig.phoneDisplay}
      </a>
    </div>
  </div>
</div>

<style>
  .emergency-bar {
    background: #DC2626;
    color: #FFFFFF;
    font-size: 0.875rem;
    padding: 0.5rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
  }

  .emergency-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem;
  }

  .emergency-left {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .pulsing-dot {
    width: 10px;
    height: 10px;
    background-color: #FFFFFF;
    border-radius: 50%;
    animation: pulse 1.5s infinite;
    display: inline-block;
  }

  @keyframes pulse {
    0% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0.7);
    }
    70% {
      transform: scale(1.15);
      box-shadow: 0 0 0 8px rgba(255, 255, 255, 0);
    }
    100% {
      transform: scale(0.95);
      box-shadow: 0 0 0 0 rgba(255, 255, 255, 0);
    }
  }

  .emergency-note {
    opacity: 0.95;
  }

  .emergency-call-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    background: #FFFFFF;
    color: #DC2626;
    font-weight: 700;
    padding: 0.35rem 0.85rem;
    border-radius: 6px;
    font-size: 0.8125rem;
    transition: transform 0.15s ease, background 0.15s ease;
  }

  .emergency-call-btn:hover {
    background: #FEE2E2;
    transform: scale(1.03);
  }

  @media (max-width: 640px) {
    .emergency-right {
      display: none;
    }
  }
</style>
