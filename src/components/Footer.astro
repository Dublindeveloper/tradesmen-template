---
import siteConfig from '../../site.config';
const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <!-- Col 1: Business info & Certs -->
      <div class="footer-col">
        <div class="footer-brand">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"></polygon></svg>
          <span>{siteConfig.businessName}</span>
        </div>
        <p class="footer-bio">{siteConfig.tagline}. Operating across Dublin since {siteConfig.yearEstablished}.</p>
        <ul class="cert-list">
          {siteConfig.certifications.map((c) => (
            <li>
              <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
              <span>{c}</span>
            </li>
          ))}
        </ul>
      </div>

      <!-- Col 2: Services links -->
      <div class="footer-col">
        <h4 class="footer-heading">Services</h4>
        <ul class="footer-links">
          {siteConfig.services.map((s) => (
            <li><a href={`/services#${s.id}`}>{s.title}</a></li>
          ))}
          <li><a href="/emergency" class="emergency-text">24/7 Emergency Response</a></li>
        </ul>
      </div>

      <!-- Col 3: Contact & Emergency -->
      <div class="footer-col">
        <h4 class="footer-heading">Direct Contact</h4>
        <p class="footer-contact-item">
          <strong>Phone:</strong>
          <a href={`tel:${siteConfig.phone}`}>{siteConfig.phoneDisplay}</a>
        </p>
        <p class="footer-contact-item">
          <strong>WhatsApp:</strong>
          <a href={`https://wa.me/${siteConfig.whatsappNumber}`} target="_blank" rel="noopener noreferrer">Chat Direct on WhatsApp</a>
        </p>
        <p class="footer-contact-item">
          <strong>Email:</strong>
          <a href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </p>
        <p class="footer-contact-item">
          <strong>Base:</strong>
          <span>{siteConfig.address}, {siteConfig.eircode}</span>
        </p>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="footer-bottom">
      <p>© {currentYear} {siteConfig.businessName}. All rights reserved. Registered in Ireland.</p>
      <p class="agency-credit">Engineered by <a href="https://webengineer.ie" target="_blank" rel="noopener">webengineer.ie</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: #0B132B;
    color: #CBD5E1;
    padding: 4.5rem 0 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .footer-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2.5rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 768px) {
    .footer-grid {
      grid-template-columns: 1.5fr 1fr 1fr;
      gap: 3rem;
    }
  }

  .footer-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.25rem;
    font-weight: 800;
    color: #FFFFFF;
    margin-bottom: 0.75rem;
  }

  .footer-brand svg {
    color: var(--color-accent);
  }

  .footer-bio {
    font-size: 0.875rem;
    line-height: 1.6;
    margin-bottom: 1.25rem;
  }

  .cert-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .cert-list li {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: #94A3B8;
  }

  .cert-list svg {
    color: #10B981;
    flex-shrink: 0;
  }

  .footer-heading {
    color: #FFFFFF;
    font-size: 1rem;
    margin-bottom: 1.25rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .footer-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    font-size: 0.875rem;
  }

  .footer-links a {
    color: #CBD5E1;
    transition: color 0.15s ease;
  }

  .footer-links a:hover {
    color: var(--color-accent);
  }

  .emergency-text {
    color: #F87171 !important;
    font-weight: 600;
  }

  .footer-contact-item {
    font-size: 0.875rem;
    margin-bottom: 0.75rem;
    line-height: 1.4;
  }

  .footer-contact-item strong {
    color: #FFFFFF;
    display: block;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin-bottom: 0.15rem;
  }

  .footer-contact-item a {
    color: #CBD5E1;
  }

  .footer-contact-item a:hover {
    color: var(--color-accent);
  }

  .footer-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-top: 2rem;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.8125rem;
    color: #64748B;
  }

  .agency-credit a {
    color: var(--color-accent);
    font-weight: 700;
  }
</style>
