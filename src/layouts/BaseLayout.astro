---
import siteConfig from '../../site.config';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import EmergencyBanner from '../components/EmergencyBanner.astro';
import MobileCallBar from '../components/MobileCallBar.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${siteConfig.businessName} | ${siteConfig.tagline}`,
  description = siteConfig.heroSubheadline,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, 'https://dublinelectrician.ie');

// JSON-LD Schema for Google LocalBusiness / Electrician SEO
const schemaData = {
  "@context": "https://schema.org",
  "@type": siteConfig.tradeType === 'electrician' ? 'Electrician' : 'Plumber',
  "name": siteConfig.businessName,
  "image": "https://dublinelectrician.ie/og-image.jpg",
  "telephone": siteConfig.phone,
  "email": siteConfig.email,
  "address": {
    "@type": "PostalAddress",
    "streetAddress": siteConfig.address,
    "addressLocality": siteConfig.county,
    "postalCode": siteConfig.eircode,
    "addressCountry": "IE"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": "53.3888",
    "longitude": "-6.3756"
  },
  "priceRange": "€€",
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
      "opens": "00:00",
      "closes": "23:59"
    }
  ],
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": siteConfig.googleRating.score,
    "reviewCount": siteConfig.googleRating.totalReviews
  }
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <!-- Dynamic Theme Styling -->
    <style is:global define:vars={{
      'color-primary': siteConfig.theme.primaryColor,
      'color-primary-hover': siteConfig.theme.primaryHover,
      'color-accent': siteConfig.theme.accentColor,
      'color-accent-hover': siteConfig.theme.accentHover,
      'color-bg-light': siteConfig.theme.lightBg
    }}></style>

    <!-- Schema.org LocalBusiness JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify(schemaData)} />
  </head>
  <body>
    {siteConfig.emergencyAvailable247 && <EmergencyBanner />}
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
  </body>
</html>
