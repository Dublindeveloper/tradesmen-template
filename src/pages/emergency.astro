---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../../site.config';
---

<BaseLayout title={`24/7 Emergency Electrician Dublin | ${siteConfig.businessName}`}>
  <section class="emergency-hero-page">
    <div class="container emergency-page-content">
      <div class="alert-pill">
        <span class="pulse-red"></span>
        <span>Emergency On-Call Duty Team Active</span>
      </div>

      <h1 class="emergency-main-title">24/7 Emergency Dublin Electrician</h1>
      <p class="emergency-lead">
        Immediate dispatch across Dublin. We respond rapidly to power outages, blown fuse boards, dangerous sparking sockets, and electrical emergencies. Average response: <strong>{siteConfig.emergencyResponseTime}</strong>.
      </p>

      <div class="emergency-cta-group">
        <a href={`tel:${siteConfig.phone}`} class="btn btn-call-huge">
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
          <span>Tap to Call Emergency Line: {siteConfig.phoneDisplay}</span>
        </a>

        <a
          href={`https://wa.me/${siteConfig.whatsappNumber}?text=EMERGENCY:%20I%20have%20an%20electrical%20issue%20in%20Dublin%20and%20need%20immediate%20assistance.`}
          target="_blank"
          rel="noopener noreferrer"
          class="btn btn-whatsapp-huge"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.521.151-.172.2-.296.3-.495.099-.198.05-.372-.025-.521-.075-.148-.669-1.611-.916-2.206-.242-.579-.487-.501-.669-.51l-.57-.01c-.198 0-.52.074-.792.372s-1.04 1.016-1.04 2.479 1.065 2.876 1.213 3.074c.149.198 2.095 3.2 5.076 4.487.709.306 1.263.489 1.694.626.712.226 1.36.194 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.695.248-1.29.173-1.414z"/></svg>
          <span>Send WhatsApp Emergency Location</span>
        </a>
      </div>

      <div class="emergency-checklist">
        <h3>What to do while waiting for our electrician:</h3>
        <ol>
          <li><strong>If you smell burning or see smoke:</strong> Turn off the main switch on your fuse board immediately if safe to do so.</li>
          <li><strong>Do not touch:</strong> Never touch any charred sockets, sparking plugs, or wet electrical fittings.</li>
          <li><strong>Keep refrigerators closed:</strong> Minimize opening fridge/freezer doors to maintain food temperature.</li>
          <li><strong>Leave external lights off:</strong> Avoid flipping switches back on until the circuit has been properly tested.</li>
        </ol>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .emergency-hero-page {
    background: #0B132B;
    color: #FFFFFF;
    padding: 5rem 0;
    min-height: 80vh;
    display: flex;
    align-items: center;
  }

  .emergency-page-content {
    max-width: 800px;
    margin: 0 auto;
    text-align: center;
  }

  .alert-pill {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(220, 38, 38, 0.2);
    border: 1px solid #DC2626;
    color: #FCA5A5;
    padding: 0.4rem 1rem;
    border-radius: 9999px;
    font-size: 0.875rem;
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .pulse-red {
    width: 8px;
    height: 8px;
    background: #EF4444;
    border-radius: 50%;
    animation: pulse 1.5s infinite;
  }

  .emergency-main-title {
    color: #FFFFFF;
    font-size: 2.5rem;
    margin-bottom: 1.25rem;
  }

  @media (min-width: 768px) {
    .emergency-main-title {
      font-size: 3.25rem;
    }
  }

  .emergency-lead {
    font-size: 1.15rem;
    color: #CBD5E1;
    line-height: 1.6;
    margin-bottom: 2.5rem;
  }

  .emergency-cta-group {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    margin-bottom: 3.5rem;
  }

  @media (min-width: 600px) {
    .emergency-cta-group {
      flex-direction: row;
      justify-content: center;
    }
  }

  .btn-call-huge {
    background: #DC2626;
    color: #FFFFFF;
    font-size: 1.05rem;
    padding: 1.1rem 2rem;
  }

  .btn-call-huge:hover {
    background: #B91C1C;
    transform: translateY(-2px);
    box-shadow: 0 6px 20px rgba(220, 38, 38, 0.4);
  }

  .btn-whatsapp-huge {
    background: #25D366;
    color: #FFFFFF;
    font-size: 1.05rem;
    padding: 1.1rem 2rem;
  }

  .btn-whatsapp-huge:hover {
    background: #20BA5C;
    transform: translateY(-2px);
  }

  .emergency-checklist {
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 12px;
    padding: 2rem;
    text-align: left;
  }

  .emergency-checklist h3 {
    color: var(--color-accent);
    font-size: 1.15rem;
    margin-bottom: 1rem;
  }

  .emergency-checklist ol {
    padding-left: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    color: #E2E8F0;
    font-size: 0.9375rem;
    line-height: 1.5;
  }
</style>
