---
import BaseLayout from '../layouts/BaseLayout.astro';
import siteConfig from '../../site.config';
import QuoteEstimator from '../components/QuoteEstimator.astro';
import TrustBadges from '../components/TrustBadges.astro';
---

<BaseLayout title={`Contact Certified Electrician Dublin | ${siteConfig.businessName}`}>
  <div class="page-header">
    <div class="container">
      <span class="badge badge-gold">Direct & Transparent</span>
      <h1 class="page-title">Contact Us & Get a Quote</h1>
      <p class="page-lead">
        Speak directly with an experienced Dublin electrician. Call, WhatsApp a photo, or submit a quotation request below.
      </p>
    </div>
  </div>

  <TrustBadges />
  <QuoteEstimator />
</BaseLayout>

<style>
  .page-header {
    background: linear-gradient(135deg, #0F1D36 0%, #172A4F 100%);
    color: #FFFFFF;
    padding: 4rem 0;
    text-align: center;
  }

  .page-title {
    color: #FFFFFF;
    font-size: 2.5rem;
    margin: 0.75rem 0 1rem;
  }

  .page-lead {
    color: #CBD5E1;
    font-size: 1.125rem;
    max-width: 620px;
    margin: 0 auto;
  }
</style>
